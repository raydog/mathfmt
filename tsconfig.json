{
  "include": ["**/*", ".**/*"],
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // Set a higher target to expose some more modern JS features:
    "target": "es2020",

    // Get TS to accept this repo's strategy, where we are destined to be bundled,
    // but will also be evaluated from node.js for tests. (Also, imports don't
    // have .js or .ts extensions, because it looks nicer that way.)
    "module": "preserve",
    "moduleResolution": "bundler",

    // For nodejs:
    "lib": ["esnext"],
    "types": ["node", "mocha"],

    // Don't use TSC as the compiler/bundler, just a type checker:
    "noEmit": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
